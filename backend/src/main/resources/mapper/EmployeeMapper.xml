<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.admin.mapper.EmployeeMapper">

    <!-- 结果映射（含部门名） -->
    <resultMap id="EmployeeResultMap" type="com.enterprise.admin.entity.Employee">
        <id     column="emp_id"      property="empId"/>
        <result column="name"        property="name"/>
        <result column="gender"      property="gender"/>
        <result column="phone"       property="phone"/>
        <result column="email"       property="email"/>
        <result column="dept_id"     property="deptId"/>
        <result column="position"    property="position"/>
        <result column="salary"      property="salary"/>
        <result column="hire_date"   property="hireDate"/>
        <result column="status"      property="status"/>
        <result column="create_by"   property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by"   property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted"     property="deleted"/>
        <result column="dept_name"   property="deptName"/>
    </resultMap>

    <!-- 分页查询员工（带部门名） -->
    <select id="selectEmployeePage" resultMap="EmployeeResultMap">
        SELECT e.*, d.dept_name
        FROM employee e
        LEFT JOIN sys_dept d ON e.dept_id = d.dept_id
        WHERE e.deleted = 0
        <if test="query.name != null and query.name != ''">
            AND e.name LIKE CONCAT('%', #{query.name}, '%')
        </if>
        <if test="query.deptId != null">
            AND e.dept_id = #{query.deptId}
        </if>
        <if test="query.status != null and query.status != ''">
            AND e.status = #{query.status}
        </if>
        <if test="query.startDate != null and query.startDate != ''">
            AND e.hire_date &gt;= #{query.startDate}
        </if>
        <if test="query.endDate != null and query.endDate != ''">
            AND e.hire_date &lt;= #{query.endDate}
        </if>
        ORDER BY e.emp_id DESC
    </select>

</mapper>
